<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Dormitory.MainPage"
             Title="Гуртожиток — робота з XML">

    <Grid ColumnDefinitions="340,*" Padding="12" ColumnSpacing="12">
        <ScrollView Grid.Column="0">
            <VerticalStackLayout Spacing="6">

                <Button Text="Обрати XML-файл" Clicked="OnPickXmlClicked"/>
                <Label x:Name="XmlFileLabel" Text="XML не обрано" FontSize="12"/>

                <Button Text="Обрати XSL-файл" Clicked="OnPickXslClicked"/>
                <Label x:Name="XslFileLabel" Text="XSL не обрано" FontSize="12"/>

                <Label Text="Ключове слово" FontAttributes="Bold" Margin="0,10,0,0"/>
                <Entry x:Name="KeywordEntry" Placeholder="напр. Іван, 312, Сирота"/>

                <Label Text="Факультет"/>
                <Picker x:Name="FacultyPicker"/>

                <Label Text="Спеціальність"/>
                <Picker x:Name="SpecialtyPicker"/>

                <Label Text="Курс"/>
                <Picker x:Name="CoursePicker"/>

                <Label Text="Корпус гуртожитку"/>
                <Picker x:Name="BuildingPicker"/>

                <Label Text="Спосіб аналізу" FontAttributes="Bold" Margin="0,10,0,0"/>
                <RadioButton x:Name="SaxRadio" Content="SAX API" GroupName="Parser" IsChecked="True"/>
                <RadioButton x:Name="DomRadio" Content="DOM API" GroupName="Parser"/>
                <RadioButton x:Name="LinqRadio" Content="LINQ to XML" GroupName="Parser"/>

                <Button Text="Пошук" Clicked="OnSearchClicked" Margin="0,10,0,0"/>
                <Button Text="Трансформувати в HTML" Clicked="OnTransformClicked"/>
                <Button Text="Clear" Clicked="OnClearClicked"/>
                <Button Text="Вихід" Clicked="OnExitClicked" BackgroundColor="DarkRed" TextColor="White"/>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Column="1" RowDefinitions="*,*" RowSpacing="8">
            <Editor x:Name="OutputEditor" Grid.Row="0" IsReadOnly="True" FontFamily="Consolas"/>
            <WebView x:Name="HtmlView" Grid.Row="1"/>
        </Grid>
    </Grid>
</ContentPage>